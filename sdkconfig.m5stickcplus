CONFIG_ENABLE_M5STICKC_DISPLAY=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
# M5GFX's SPI-driven display code pushes the app over the IRAM budget;
# moving the SPI master ISR out of IRAM (small latency cost, not a concern
# for a periodically-updated sensor display) reclaims enough to fit.
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# The M5GFX/M5Unified display stack leaves little headroom in the stock
# 1700K OTA app slots (partitions_two_ota_large.csv), so use a dedicated
# partition table with larger slots for this build variant.
# CONFIG_PARTITION_TABLE_TWO_OTA_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_m5stickcplus.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_m5stickcplus.csv"

# The base sdkconfig points OTA at the standard build's release asset
# (weight.bin). The M5StickC Plus release job publishes its binary under a
# distinct name (weight-m5stickcplus.bin, see .github/workflows/release.yml)
# so the two variants don't collide on the same release -- override the URL
# here so M5StickC Plus devices OTA to the matching binary instead of the
# incompatible standard build.
CONFIG_OTA_FIRMWARE_UPGRADE_URL="https://github.com/jcodybaker/esp32-sensor-station/releases/latest/download/weight-m5stickcplus.bin"

# Hall-effect flow sensor support is listed explicitly here (matching the
# Kconfig defaults) so this variant's supported sensors stay documented even
# if the base sdkconfig/Kconfig defaults change later.
CONFIG_ENABLE_FLOW_SENSOR=y
# CONFIG_FLOW_SENSOR_PERSIST_TOTALS is not set

# BTHome BLE observation isn't used on M5StickC Plus display units; explicit
# here (matching the Kconfig default) so this variant's disabled features stay
# documented even if the base default changes later.
# CONFIG_ENABLE_BTHOME is not set

# Bluedroid reserves heap for its GATT server/client and pairing/bonding at
# init regardless of whether the app uses them; this build only ever does
# passive BLE scanning (and only when CONFIG_ENABLE_BTHOME is on for a
# specific device), so disable all three -- one of the largest contributors
# to the boot-time heap exhaustion that broke the M5Stick display task.
# CONFIG_BT_GATTS_ENABLE is not set
# CONFIG_BT_GATTC_ENABLE is not set
# CONFIG_BT_BLE_SMP_ENABLE is not set

# Without this, mbedtls allocates the full CONFIG_MBEDTLS_SSL_IN/OUT_CONTENT_LEN
# (16KB/4KB) for the life of every TLS connection (MQTT, OTA) regardless of
# actual record size. Enabling it lets buffers shrink to what's in flight.
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
